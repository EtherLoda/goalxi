##== Environment
NODE_ENV=development

## Which slice of the api process to boot. See `api/src/utils/modules-set.ts`.
##   api         — HTTP API + the api-owned queue consumers (default)
##   background  — queue consumers only, no HTTP. Registered NO cron.
##   monolith    — deprecated alias of `api`, kept so existing deploys boot.
##
## This process registers NO settlement `@Cron`. Every settlement cron
## (season transition, promotion/relegation, league awards, weekly
## settlement, ...) is owned exclusively by the `settlement` process.
## A value here that implies otherwise used to make each one run twice,
## double-writing rows — there was no distributed lock on those handlers.
##
## Leave unset to get `api`.
# MODULES_SET=api

## GAME_START_DATE is intentionally NOT set here. The season/week anchor lives
## in the `system_config` table (key=`init_date`, written by
## `pnpm init:run`) and system_config takes precedence over the env var --
## see libs/database/src/services/init-date-resolver.ts. Setting the env var only
## looks like it works: on an initialised DB it is read and discarded, so the
## boot log ends up printing two different dates. The env fallback only matters
## on a fresh DB that has not run init:run yet.
##== Application
APP_NAME="NestJS API"
APP_URL=http://localhost:3000
APP_PORT=3000
APP_DEBUG=false
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_LOG_LEVEL=debug
APP_LOG_SERVICE=console
APP_CORS_ORIGIN=http://localhost:3000,http://example.com

##== Database
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nestjs_api
DATABASE_LOGGING=true
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

##== Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_TLS_ENABLED=false

##== Mailer
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=No Reply
MAIL_CLIENT_PORT=1080

##== Authentication
AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=1d
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=365d
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=7d
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

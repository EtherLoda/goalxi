<!doctype html>
<html lang="en">

<head>
  <meta name="viewport" content="width=device-width" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>Verify your GoalXI email</title>
  <style>
    /* ----- resets ----- */
    img {
      border: none;
      -ms-interpolation-mode: bicubic;
      max-width: 100%;
    }

    body {
      background-color: #f6f6f6;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
      font-size: 14px;
      line-height: 1.5;
      margin: 0;
      padding: 0;
      color: #1f2933;
    }

    table {
      border-collapse: collapse;
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
      width: 100%;
    }

    table td {
      font-size: 14px;
      vertical-align: top;
    }

    a {
      color: #16a34a;
      text-decoration: none;
    }

    /* ----- layout ----- */
    .body {
      background-color: #f6f6f6;
      width: 100%;
    }

    .container {
      display: block;
      margin: 0 auto;
      max-width: 560px;
      padding: 24px 10px;
      width: 560px;
    }

    .main {
      background: #ffffff;
      border-radius: 8px;
      border: 1px solid #e5e7eb;
    }

    .wrapper {
      padding: 32px 28px;
    }

    .header {
      padding: 24px 28px 0;
      text-align: center;
    }

    .header .brand {
      font-size: 22px;
      font-weight: 700;
      color: #16a34a;
      letter-spacing: 0.5px;
    }

    .footer {
      padding: 20px 28px 28px;
      text-align: center;
      color: #6b7280;
      font-size: 12px;
    }

    /* ----- typography ----- */
    h1 {
      font-size: 22px;
      font-weight: 600;
      margin: 0 0 16px;
      color: #1f2933;
    }

    p {
      margin: 0 0 14px;
    }

    .muted {
      color: #6b7280;
      font-size: 13px;
    }

    /* ----- button ----- */
    .btn {
      display: inline-block;
      background-color: #16a34a;
      color: #ffffff !important;
      border-radius: 6px;
      padding: 12px 22px;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
    }

    .btn-wrap {
      padding: 8px 0 16px;
    }

    .preheader {
      color: transparent;
      display: none;
      height: 0;
      max-height: 0;
      max-width: 0;
      opacity: 0;
      overflow: hidden;
      mso-hide: all;
      visibility: hidden;
      width: 0;
    }

    @media only screen and (max-width: 620px) {
      .container {
        width: 100% !important;
        padding: 0 !important;
      }

      .main {
        border-radius: 0 !important;
        border-left: 0 !important;
        border-right: 0 !important;
      }

      .wrapper,
      .header,
      .footer {
        padding-left: 20px !important;
        padding-right: 20px !important;
      }

      .btn {
        display: block !important;
        width: 100% !important;
        text-align: center !important;
      }
    }
  </style>
</head>

<body>
  <span class="preheader">Confirm your email to finish signing up for GoalXI.</span>
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="body">
    <tr>
      <td>&nbsp;</td>
      <td class="container">
        <div class="header">
          <div class="brand">⚽ GoalXI</div>
        </div>
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="main">
          <tr>
            <td class="wrapper">
              <h1>Verify your email</h1>
              <p>Hi {{email}},</p>
              <p>Thanks for signing up for GoalXI. Tap the button below to confirm your email and activate your account.</p>
              <p class="btn-wrap">
                <a href="{{url}}" class="btn" target="_blank">Verify email</a>
              </p>
              <p class="muted">If the button doesn't work, paste this link into your browser:</p>
              <p><a href="{{url}}" style="word-break: break-all;">{{url}}</a></p>
              <p class="muted">This link expires in 24 hours. If you didn't create a GoalXI account, you can safely ignore this email.</p>
            </td>
          </tr>
        </table>
        <div class="footer">
          <p>GoalXI · Football Manager</p>
          <p>You're receiving this email because someone signed up at GoalXI with this address. If it wasn't you, just ignore the message.</p>
        </div>
      </td>
      <td>&nbsp;</td>
    </tr>
  </table>
</body>

</html>

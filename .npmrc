# pnpm 10 strict isolation breaks NestJS apps that resolve
# transitive deps (express, passport, etc.) from the api
# worktree — pnpm 9 used to hoist them automatically via
# `hoistPattern: '*'`, but pnpm 10 only honours the explicit
# `shamefully-hoist` flag. Without it, `api/dist/main` fails
# with `Cannot find module 'express'` even though the package
# is present in `node_modules/.pnpm/...`.
#
# Cost: increases the size of `api/node_modules` because
# every dep gets a top-level symlink. Acceptable for a
# monorepo this size; revisit if disk pressure becomes a
# concern.
shamefully-hoist=true

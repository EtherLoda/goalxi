##== Environment
NODE_ENV=development

## `MODULES_SET` is NOT read by this service — it is an api-only variable.
## It was previously present here (set to `monolith`) which was doubly
## misleading: this process never read it, and the value implied the api
## process owned settlement cron. It does not — this service is the sole
## owner of every settlement `@Cron`.

## GAME_START_DATE is intentionally NOT set here. The season/week anchor lives
## in the `system_config` table (key=`init_date`, written by
## `pnpm init:run`) and system_config takes precedence over the env var --
## see libs/database/src/services/init-date-resolver.ts. Setting the env var only
## looks like it works: on an initialised DB it is read and discarded, so the
## boot log ends up printing two different dates. The env fallback only matters
## on a fresh DB that has not run init:run yet.

##== Application
APP_NAME="GoalXI Settlement"
APP_URL=http://localhost:3001
APP_PORT=3001
PORT=3001
APP_DEBUG=false
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_LOG_LEVEL=debug
APP_LOG_SERVICE=console
APP_CORS_ORIGIN=http://localhost:3000,http://localhost:8000

##== Database
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=25432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=goalxi
DATABASE_LOGGING=true
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

## Settlement's TypeORM config reads the DB_* prefix.
DB_HOST=localhost
DB_PORT=25432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=goalxi

##== Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_TLS_ENABLED=false
##== Environment
NODE_ENV=development

## `MODULES_SET` is NOT read by this service — it is an api-only variable.
## It was previously present here (set to `monolith`) which was doubly
## misleading: this process never read it, and the value implied the api
## process owned settlement cron. It does not — this service is the sole
## owner of every settlement `@Cron`.

##== Game clock
## Season/week grid anchor. MUST be a Monday (UTC) — `resolveGameStart`
## throws at boot otherwise, because a non-Monday anchor silently misaligns
## every `week === N` trigger (playoff generation, awards, season
## transition) by up to a day.
##
## MUST be set in every service (api / settlement / simulator). Unset falls
## back to `startOfUtcDay(today)` and RE-ANCHORS on every restart, which
## changes `season`/`week` — and therefore changes every BullMQ jobId here
## (they embed season/week as their dedup key), letting the same
## real-world week run its settlement tick twice.
GAME_START_DATE=2026-10-05

##== Application
APP_NAME="GoalXI Settlement"
APP_URL=http://localhost:3001
APP_PORT=3001
PORT=3001
APP_DEBUG=false
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_LOG_LEVEL=debug
APP_LOG_SERVICE=console
APP_CORS_ORIGIN=http://localhost:3000,http://localhost:8000

##== Database
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=25432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=goalxi
DATABASE_LOGGING=true
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

## Settlement's TypeORM config reads the DB_* prefix.
DB_HOST=localhost
DB_PORT=25432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=goalxi

##== Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_TLS_ENABLED=false